# Production environment variables – the 7 that must be set on Vercel.
# For the full reference (user-level API keys, mailboxes, LLM, Sheets, daily
# limits, etc.) see docs/API_KEYS.md. User-level keys (Brave, Groq, Hunter,
# Places) are entered per-account in Settings, not here.

# --- Database (Postgres/Supabase) --- REQUIRED, runtime
GTM_DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# --- Authentication (Supabase Auth) --- REQUIRED, runtime
GTM_SUPABASE_URL=https://your-project.supabase.co

# --- Encryption (per-user API key storage) --- REQUIRED, runtime
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GTM_ENCRYPTION_KEY=

# --- GitHub Actions dispatch --- REQUIRED for campaign runs, runtime
GTM_GITHUB_TOKEN=
GTM_GITHUB_REPO=grydinteam/qualifyr

# --- Frontend (Supabase client) --- REQUIRED, BUILD-TIME (redeploy after changing)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
